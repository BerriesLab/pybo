# Virtual environment
venv/
env/
.env

# Virtual environment cleanup
.venv_cleanup/
# IDE-specific files
.vscode/
.idea/

# Data
# unique_dir() avoids a collision by suffixing, so data_001, data_002 ... appear beside
# data/; the glob covers the whole family rather than just the first name.
/tutorials/**/**/data*/
/studies/data*/
# A study writes its sweep under data/studies*/ when --output-dir points there, one
# run directory per replicate. That is generated output, regenerable from the study
# command, and it dwarfs the ported campaigns that data/ exists to hold.
/data/studies*/
# The pasteable ground-truth bodies build_polynomial_gt --paste-out writes: a copy of
# coefficients the objective already holds in full, so keeping it invites the two to
# disagree.
/tutorials/**/gt_bodies.txt
/tutorials/**/gnd_truth.txt
/dist/
/tutorials/multi_objective/avagama/

# macOS
.DS_Store

# Python bytecode
__pycache__/
*.py[cod]
/.claude/

# Build / test artifacts
/build/
*.egg-info/
.pytest_cache/

# Reference copies of the other project's analysis scripts, kept on disk for
# comparison while studies/analysis was written. They import that project's
# `configs` / `utils` packages, so they do not run here.
/bayesian_campaign_analysis/
/.venv/
/data/
*.zip
